<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BrBrDbTelemetryInstallerTests</AssemblyName>
    <RootNamespace>BrBrDbTelemetry</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Program.cs" />
    <Compile Remove="InstallerForm.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\rfactor_plugin\build\bin\Release\BrBrDbTelemetry64.dll" Link="BrBrDbTelemetry64.dll" Condition="Exists('..\rfactor_plugin\build\bin\Release\BrBrDbTelemetry64.dll')" />
    <EmbeddedResource Include="..\brbrdaemon\build\bin\Release\brbrdaemon.exe" Link="brbrdaemon.exe" Condition="Exists('..\brbrdaemon\build\bin\Release\brbrdaemon.exe')" />
  </ItemGroup>

</Project>
