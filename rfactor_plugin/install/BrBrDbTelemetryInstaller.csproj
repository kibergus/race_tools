<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <AssemblyName>BrBrDbTelemetryInstaller</AssemblyName>
    <RootNamespace>BrBrDbTelemetry</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="InstallManagerTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\build\bin\Release\BrBrDbTelemetry64.dll" Link="BrBrDbTelemetry64.dll" Condition="Exists('..\build\bin\Release\BrBrDbTelemetry64.dll')" />
  </ItemGroup>

</Project>
